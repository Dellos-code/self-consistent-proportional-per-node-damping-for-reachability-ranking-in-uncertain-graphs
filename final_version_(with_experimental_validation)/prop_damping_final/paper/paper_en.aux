\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dynamics of the realizations (development panel). (a)~Fraction of vertices on the trivial branch $y_i=x_i$ for Realizations A, B and C on $EW$ at the raw scale: under uniform priors A collapses at $t=1$ (Proposition~A) and B is absorbed within a few steps (Proposition~B). (b)~Mean Spearman $\rho $ along the iterations, colours as in~(a); solid: $EW$, raw scale; dashed: $EW$, excess scale $\gamma =16$; dotted: Realization~C on the raw adjacency $P$. Every configuration stays below the calibrated rule of~\cite  {konstantellos26}. (c)~Spectral radii of the Jacobians at the positive self-consistent point for $T=\lambda W$; both exceed one on $1<\lambda <2$ (Proposition~C); circles are numerical values. (d)~The Realization~C update $S\DOTSB \mapstochar \rightarrow L_2(x,S)/x$: it falls below the prior when $S<x$ and decreases on $S<(\sqrt  2-1)x$ (Proposition~D).}}{6}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:dynamics}{{1}{6}{Dynamics of the realizations (development panel). (a)~Fraction of vertices on the trivial branch $y_i=x_i$ for Realizations A, B and C on $EW$ at the raw scale: under uniform priors A collapses at $t=1$ (Proposition~A) and B is absorbed within a few steps (Proposition~B). (b)~Mean Spearman $\rho $ along the iterations, colours as in~(a); solid: $EW$, raw scale; dashed: $EW$, excess scale $\gamma =16$; dotted: Realization~C on the raw adjacency $P$. Every configuration stays below the calibrated rule of~\cite {konstantellos26}. (c)~Spectral radii of the Jacobians at the positive self-consistent point for $T=\lambda W$; both exceed one on $1<\lambda <2$ (Proposition~C); circles are numerical values. (d)~The Realization~C update $S\mapsto L_2(x,S)/x$: it falls below the prior when $S<x$ and decreases on $S<(\sqrt 2-1)x$ (Proposition~D)}{figure.caption.5}{}}
